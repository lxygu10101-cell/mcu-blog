---
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/site';
---
<Layout title="全文搜索"><section class="wrap page-section"><p class="eyebrow">FIND SOMETHING USEFUL</p><h1 class="page-title">找一段思路，或一个答案。</h1><form role="search" class="search-box" id="search-form"><label class="sr-only" for="query">搜索文章与项目</label><input class="search-input" id="query" type="search" name="q" placeholder="搜索 STM32、C 语言、Markdown…" autocomplete="off" aria-describedby="search-status"/></form><p class="search-count" id="search-status" role="status">正在载入搜索索引…</p><div id="search-results" data-index={url('search-index.json')}></div><noscript><p>搜索需要启用 JavaScript。你也可以通过导航浏览全部文章与项目。</p></noscript></section><style>.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}</style><script>
type Row={title:string;description:string;tags:string[];type:string;href:string;text:string};
const input=document.getElementById('query') as HTMLInputElement;const container=document.getElementById('search-results')!;const status=document.getElementById('search-status')!;let rows:Row[]=[];
const normalize=(value:string)=>value.normalize('NFKC').toLowerCase();
function search(){const query=input.value.trim();const tokens=normalize(query).split(/\s+/).filter(Boolean);const found=rows.filter(row=>tokens.every(token=>normalize(`${row.title} ${row.description} ${row.tags.join(' ')} ${row.text}`).includes(token)));status.textContent=query?`找到 ${found.length} 条与“${query}”相关的内容`:`共 ${rows.length} 条内容，输入关键词开始搜索`;container.replaceChildren();for(const row of found){const link=document.createElement('a');link.className='search-result';link.href=row.href;const type=document.createElement('span');type.className='result-type';type.textContent=row.type+' · '+row.tags.join(' / ');const title=document.createElement('h2');title.textContent=row.title;const desc=document.createElement('p');desc.textContent=row.description;link.append(type,title,desc);container.append(link);}if(!found.length){const p=document.createElement('p');p.className='empty-state';p.textContent='暂时没有匹配内容，试试更短的词，或浏览全部文章。';container.append(p);}}
document.getElementById('search-form')!.addEventListener('submit',e=>e.preventDefault());
try{const response=await fetch(container.dataset.index!);if(!response.ok)throw Error('index');rows=await response.json();input.value=new URLSearchParams(location.search).get('q')||'';search();input.addEventListener('input',()=>{const params=new URLSearchParams();if(input.value)params.set('q',input.value);history.replaceState(null,'',`${location.pathname}${params.size?'?'+params:''}`);search();});}catch{status.textContent='搜索索引加载失败，请刷新页面后重试。';}
</script></Layout>

---
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/site';
---
<Layout title="搜索" description="站内全文搜索，快速检索 STM32、C 语言、外设驱动与项目记录。">
  <section class="wrap page-section">
    <header class="page-header">
      <p class="eyebrow">SEARCH</p>
      <h1 class="page-title">站内搜索</h1>
      <p class="page-lead">按关键词、标签或正文内容检索全部技术文章与项目记录。</p>
    </header>

    <form role="search" class="search-box" id="search-form">
      <label class="sr-only" for="query">搜索文章与项目</label>
      <input
        class="search-input"
        id="query"
        type="search"
        name="q"
        placeholder="输入关键词，例如 STM32、定时器、状态机、UART…"
        autocomplete="off"
        autofocus
        aria-describedby="search-status"
      />
    </form>

    <p class="search-count tabular" id="search-status" role="status">正在载入搜索索引…</p>
    <div class="search-results" id="search-results" data-index={url('search-index.json')}></div>

    <noscript>
      <p class="empty-state">搜索需要启用 JavaScript。你也可以通过顶部导航浏览全部文章与项目。</p>
    </noscript>
  </section>

  <script>
    type Row = {
      title: string;
      description: string;
      tags: string[];
      type: string;
      href: string;
      text: string;
    };

    const input = document.getElementById('query') as HTMLInputElement;
    const container = document.getElementById('search-results')!;
    const status = document.getElementById('search-status')!;
    let rows: Row[] = [];

    const normalize = (value: string) => value.normalize('NFKC').toLowerCase();

    function renderResults() {
      const query = input.value.trim();
      container.replaceChildren();

      if (!rows.length) {
        status.textContent = '当前暂无已发布的文章或项目';
        const empty = document.createElement('div');
        empty.className = 'empty-panel';
        const title = document.createElement('p');
        title.className = 'empty-panel-title';
        title.textContent = '暂无可检索内容';
        const desc = document.createElement('p');
        desc.className = 'empty-panel-desc';
        desc.textContent = '发布文章或嵌入式项目后，可在此按关键词与标签实时搜索。';
        empty.append(title, desc);
        container.append(empty);
        return;
      }

      const tokens = normalize(query).split(/\s+/).filter(Boolean);
      const found = rows.filter((row) =>
        tokens.every((token) =>
          normalize(`${row.title} ${row.description} ${row.tags.join(' ')} ${row.text}`).includes(token)
        )
      );

      status.textContent = query
        ? `找到 ${found.length} 条与“${query}”相关的内容`
        : `共索引 ${rows.length} 条内容，输入关键词即时筛选`;

      for (const row of found) {
        const link = document.createElement('a');
        link.className = 'search-result';
        link.href = row.href;

        const meta = document.createElement('div');
        meta.className = 'search-result-meta';
        meta.textContent = row.tags.length ? `${row.type} · ${row.tags.join(' / ')}` : row.type;

        const title = document.createElement('h2');
        title.textContent = row.title;

        const desc = document.createElement('p');
        desc.textContent = row.description;

        link.append(meta, title, desc);
        container.append(link);
      }

      if (!found.length) {
        const empty = document.createElement('p');
        empty.className = 'empty-state';
        empty.textContent = '没有找到匹配内容，可以换一个更简短的关键词，或直接浏览项目与博客列表。';
        container.append(empty);
      }
    }

    document.getElementById('search-form')!.addEventListener('submit', (e) => e.preventDefault());

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && input.value) {
        input.value = '';
        history.replaceState(null, '', location.pathname);
        renderResults();
      }
    });

    try {
      const response = await fetch(container.dataset.index!);
      if (!response.ok) throw new Error('index');
      rows = await response.json();
      input.value = new URLSearchParams(location.search).get('q') || '';
      renderResults();
      input.addEventListener('input', () => {
        const params = new URLSearchParams();
        if (input.value) params.set('q', input.value);
        history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`);
        renderResults();
      });
    } catch {
      status.textContent = '搜索索引加载失败，请刷新页面后重试。';
    }
  </script>
</Layout>

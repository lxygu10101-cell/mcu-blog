---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { url, formatDate } from '../lib/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---
<Layout>
  <section class="intro">
    <div class="wrap">
      <p class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        EMBEDDED SYSTEMS · FIRMWARE &amp; NOTES
      </p>
      <h1 class="intro-title">嵌入式开发笔记与硬件项目</h1>
      <p class="intro-lead">
        围绕 STM32、C 语言、外设驱动与通信协议，记录硬件设计、固件实现与调试验证过程。
      </p>
      <div class="intro-meta">
        <div class="intro-actions">
          <a class="button primary" href={url('projects/')}>查看项目</a>
          <a class="button secondary" href={url('blog/')}>阅读博客</a>
        </div>
        <ul class="focus-list" aria-label="主要关注方向">
          <li class="mono">STM32</li>
          <li class="mono">C / C++</li>
          <li>外设驱动</li>
          <li>通信协议</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="wrap">
      <div class="section-head">
        <div class="section-title-group">
          <span class="section-index">01</span>
          <h2>精选项目</h2>
        </div>
        <a class="quiet-link" href={url('projects/')}>全部项目 <span>→</span></a>
      </div>
      <p class="section-hint">记录系统架构、固件实现与调试过程；当前条目为可替换的示例项目模板。</p>
      <div class="project-grid">
        {projects.map((project) => (
          <ProjectCard project={project} headingTag="h3" />
        ))}
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="wrap">
      <div class="section-head">
        <div class="section-title-group">
          <span class="section-index">02</span>
          <h2>最新文章</h2>
        </div>
        <a class="quiet-link" href={url('blog/')}>全部文章 <span>→</span></a>
      </div>
      <div class="post-list">
        {posts.map((post) => (
          <a class="post-row" href={url(`blog/${post.id}/`)}>
            <time class="post-date mono" datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <div class="post-content">
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-excerpt">{post.data.description}</p>
              <div class="post-meta-line">
                <span class="post-category">{post.data.category}</span>
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
            <span class="post-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

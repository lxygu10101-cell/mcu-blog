---
import Layout from '../layouts/Layout.astro';
import Board from '../components/Board.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { url, date } from '../lib/site';
const projects = (await getCollection('projects', ({data})=>!data.draft)).slice(0,2);
const posts = (await getCollection('blog', ({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Layout>
<section class="hero wrap">
  <div class="hero-copy"><p class="eyebrow"><span class="small-square"></span> EMBEDDED SYSTEMS · BUILD & DOCUMENT</p><h1>把想法，<br/>写进<span class="accent">硬件。</span></h1><p class="hero-description">从一行 C 语言，到一块会思考的电路板。<br/>在这里，记录嵌入式开发的探索、实践与思考。</p><div class="hero-actions"><a class="button primary" href={url('projects/')}>探索项目</a><a class="button secondary" href={url('blog/')}>阅读开发手记</a></div><div class="hero-skills"><span>STM32</span><span>C / C++</span><span>硬件与固件</span><span>持续探索</span></div></div>
  <div class="hero-visual"><div class="visual-top"><span>WORKBENCH / 嵌入式工作台</span><span class="mono">[ μC ]</span></div><Board/><div class="signal-strip"><svg viewBox="0 0 190 26" aria-hidden="true"><path d="M0 21H20V5H45V21H65V5H90V21H110V5H135V21H155V5H180V21H190" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><span>想法 · 代码 · 电路 · 实现</span></div></div>
</section>
<div class="topic-band"><div class="wrap"><span>小小的芯片，无限的可能</span><div><span>裸机开发</span><b>·</b><span>通信协议</span><b>·</b><span>驱动设计</span><b>·</b><span>工程实践</span></div></div></div>
<section class="section wrap"><div class="section-head"><div><p class="eyebrow">SELECTED PROJECTS</p><h2>在实践中，连接想法。</h2></div><a class="quiet-link" href={url('projects/')}>全部项目 <span>＋</span></a></div><p class="section-intro">硬件、固件与完整的开发过程。以下为可替换的示例项目。</p><div class="project-grid">{projects.map(project=><ProjectCard project={project}/>)}</div></section>
<section class="section wrap notes-section"><div class="section-head"><div><p class="eyebrow">FIELD NOTES</p><h2>开发路上的一些记录。</h2></div><a class="quiet-link" href={url('blog/')}>全部文章 <span>＋</span></a></div><div class="post-list">{posts.map(post=><a class="post-row" href={url(`blog/${post.id}/`)}><span class="post-date mono">{date(post.data.date)}</span><div><div class="post-meta">{post.data.category}</div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="row-plus" aria-hidden="true">＋</span></a>)}</div></section>
<section class="tool-banner wrap"><div class="tool-symbol">0x<span>FF</span></div><div><p class="eyebrow">SMALL TOOLS, LESS FRICTION</p><h2>少一点换算，多一点专注。</h2><p>进制转换、定时器计算、CRC 校验，打开即用。</p></div><a class="button secondary" href={url('tools/')}>打开工具箱</a></section>
</Layout>
